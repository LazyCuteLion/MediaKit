<Window x:Class="MediaKit.WPF.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="https://github.com/LazyCuteLion/MediaKit"
        Title="MediaKit.WPF Demo"
        Width="1280"
        Height="760">

    <Grid x:Name="container" Background="Green">
        <MediaElement x:Name="player"
                      LoadedBehavior="Manual"
                      RenderTransformOrigin="0,0"
                      Stretch="Uniform"
                      media:MediaBehavior.Interval="100" />
        <StackPanel VerticalAlignment="Bottom">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           Text="{Binding (media:MediaBehavior.Position), ElementName=player, StringFormat=mm\\:ss}" />
                <Slider Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding (media:MediaBehavior.Progress), ElementName=player}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="{Binding (media:MediaBehavior.Duration), ElementName=player, StringFormat=mm\\:ss}" />
            </Grid>
            <Grid Height="32"
                  Background="#1D000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <RadioButton x:Name="rbVR"
                             Checked="RadioButton_Checked"
                             Content="VR"
                             Foreground="White" />
                <RadioButton x:Name="rbTile"
                             Margin="20,0"
                             Checked="RadioButton_Checked"
                             Content="Tile"
                             Foreground="White" />
                <RadioButton x:Name="rbAlpha"
                             Checked="RadioButton_Checked"
                             Content="Alpha"
                             Foreground="White" />
            </StackPanel>
            <StackPanel Name="Panel_VR"
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           Text="Zoom：" />
                <Slider x:Name="sliderZoom"
                        Width="100"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Minimum="0"
                        Value="0.5" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="Fov：" />
                <Slider x:Name="sliderFov"
                        Width="100"
                        VerticalAlignment="Center"
                        Maximum="180"
                        Minimum="0"
                        Value="90" />
            </StackPanel>
            <StackPanel Name="Panel_Tile"
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           Text="Columns：" />
                <Slider x:Name="sliderColumns"
                        Width="100"
                        IsSnapToTickEnabled="True"
                        Maximum="4"
                        Minimum="1"
                        TickPlacement="Both"
                        Value="1" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="Rows：" />
                <Slider x:Name="sliderRows"
                        Width="100"
                        IsSnapToTickEnabled="True"
                        Maximum="4"
                        Minimum="1"
                        TickPlacement="Both"
                        Value="1" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="Spacing：" />
                <Slider x:Name="sliderSpacing"
                        Width="100"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
            </StackPanel>
            <StackPanel Name="Panel_Alpha"
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           Text="Position：" />
                <RadioButton Checked="AlphaPos_Checked"
                             Content="Left"
                             Foreground="White" />
                <RadioButton Margin="10,0"
                             Checked="AlphaPos_Checked"
                             Content="Top"
                             Foreground="White" />
                <RadioButton Checked="AlphaPos_Checked"
                             Content="Right"
                             Foreground="White"
                             IsChecked="True" />
                <RadioButton Margin="10,0"
                             Checked="AlphaPos_Checked"
                             Content="Bottom"
                             Foreground="White" />
            </StackPanel>
            <Button Grid.Column="2"
                    Margin="10,0"
                    Padding="8,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="BtnOpen_Click"
                    Content="Open" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
