<Project>

  <UsingTask TaskName="GenerateEffectStubs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SkslFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <EffectsDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var regex = new Regex(@"^//\s*@effect\s*(?::\s*(\w+))?", RegexOptions.Multiline);
        
        if (!Directory.Exists(EffectsDir))
            Directory.CreateDirectory(EffectsDir);

        // 收集当前所有 @effect 对应的类名，并检测重复
        var validClassNames = new System.Collections.Generic.HashSet<string>();
        var classToFiles = new System.Collections.Generic.Dictionary<string, System.Collections.Generic.List<string>>();

        foreach (var item in SkslFiles)
        {
            var path = item.GetMetadata("FullPath");
            if (!File.Exists(path)) continue;

            var content = File.ReadAllText(path);
            var match = regex.Match(content);
            if (!match.Success) continue;

            var markerVal = match.Groups[1].Success ? match.Groups[1].Value : null;
            // @effect: default → 仅注册描述符，不生成强类型类，跳过骨架生成与重复检测
            if (string.Equals(markerVal, "default", StringComparison.OrdinalIgnoreCase))
                continue;

            var fileName = Path.GetFileNameWithoutExtension(path);
            // 文件名派生类名时首字母大写（与源生成器 Capitalize 对齐，bg1 → Bg1Effect）
            var className = !string.IsNullOrEmpty(markerVal)
                ? markerVal
                : (fileName.Length > 0 ? char.ToUpperInvariant(fileName[0]) + fileName.Substring(1) : fileName) + "Effect";

            validClassNames.Add(className);
            if (!classToFiles.TryGetValue(className, out var list))
                classToFiles[className] = list = new System.Collections.Generic.List<string>();
            list.Add(fileName + ".sksl");
        }

        // 报告重复
        foreach (var kv in classToFiles)
        {
            if (kv.Value.Count > 1)
                Log.LogError("效果名称 '{0}' 在多个 .sksl 文件中重复定义：{1}", kv.Key, string.Join(", ", kv.Value));
        }

        // 为每个 @effect 生成骨架文件
        foreach (var kv in classToFiles)
        {
            if (kv.Value.Count > 1) continue;
            var className = kv.Key;

            var userFile = Path.Combine(EffectsDir, className + ".cs");
            if (File.Exists(userFile)) continue;

            var sb = new StringBuilder();
            sb.AppendLine("using Avalonia.Controls;");
            sb.AppendLine();
            sb.AppendLine("namespace MediaKit.Avalonia.Effects;");
            sb.AppendLine();
            sb.AppendLine("/// <summary>");
            sb.AppendLine("/// " + className + " 的用户自定义逻辑部分。");
            sb.AppendLine("/// 属性（DirectProperty）和构造函数由 Source Generator 自动生成于 " + className + ".g.cs 中。");
            sb.AppendLine("/// </summary>");
            sb.AppendLine("public partial class " + className);
            sb.AppendLine("{");
            sb.AppendLine("    // === 生命周期 ===");
            sb.AppendLine("    //");
            sb.AppendLine("    // Effect 被附加到目标控件后调用。可在此注册事件（如 PointerPressed）。");
            sb.AppendLine("    // Target 属性此时已可用。");
            sb.AppendLine("    //");
            sb.AppendLine("    // protected override void OnAttached(Control target)");
            sb.AppendLine("    // {");
            sb.AppendLine("    //     target.PointerPressed += OnPointerPressed;");
            sb.AppendLine("    // }");
            sb.AppendLine("    //");
            sb.AppendLine("    // Effect 即将从控件分离时调用。务必取消事件订阅。");
            sb.AppendLine("    //");
            sb.AppendLine("    // protected override void OnDetaching()");
            sb.AppendLine("    // {");
            sb.AppendLine("    //     if (Target != null)");
            sb.AppendLine("    //         Target.PointerPressed -= OnPointerPressed;");
            sb.AppendLine("    // }");
            sb.AppendLine();
            sb.AppendLine("    // === 参数推送 ===");
            sb.AppendLine("    //");
            sb.AppendLine("    // 生成的属性 setter 已自动推送，一般无需手写。");
            sb.AppendLine("    // 需要推送没标 @property 的 uniform 时：");
            sb.AppendLine("    //");
            sb.AppendLine("    // SetUniform(\"uniformName\", 0.5f);");
            sb.AppendLine();
            sb.AppendLine("    // === 自定义渲染与动画帧更新 ===");
            sb.AppendLine("    //");
            sb.AppendLine("    // 帧回调在 Renderer（合成线程）上，不在本类。要自定义就派生一个");
            sb.AppendLine("    // Renderer，并从 CreateRenderer 返回它：");
            sb.AppendLine("    //");
            sb.AppendLine("    // internal override ShaderRenderer CreateRenderer(");
            sb.AppendLine("    //     string sksl, Dictionary<string, object> uniforms, Dictionary<string, Uri?> textures)");
            sb.AppendLine("    //     => new " + className + "Renderer(this, sksl, uniforms, textures);");
            sb.AppendLine("}");
            sb.AppendLine();
            sb.AppendLine("// 渲染器只有 ShaderRenderer 一个：取表面还是取图片由 .sksl 里的 @surface / @texture 标记定。");
            sb.AppendLine("//");
            sb.AppendLine("// internal sealed class " + className + "Renderer : ShaderRenderer");
            sb.AppendLine("// {");
            sb.AppendLine("//     internal " + className + "Renderer(ShaderEffect owner, string sksl,");
            sb.AppendLine("//         Dictionary<string, object> uniforms, Dictionary<string, Uri?> textures)");
            sb.AppendLine("//         : base(owner, sksl, uniforms, textures) { }");
            sb.AppendLine("//");
            sb.AppendLine("//     // 每帧回调（仅在 StartAnimation() 后激活）。");
            sb.AppendLine("//     // 返回 true 继续下一帧，返回 false 停止动画。");
            sb.AppendLine("//     protected override bool OnFrameUpdate(double elapsed) => false;");
            sb.AppendLine("// }");

            File.WriteAllText(userFile, sb.ToString(), new UTF8Encoding(false));
            Log.LogMessage(MessageImportance.High, "Generated effect stub: " + userFile);
        }

        // 清理已不存在对应 .sksl 的用户侧 .cs 文件
        foreach (var csFile in Directory.GetFiles(EffectsDir, "*.cs"))
        {
            var csClassName = Path.GetFileNameWithoutExtension(csFile);
            if (!validClassNames.Contains(csClassName)) 
            {
                File.Delete(csFile);
                Log.LogMessage(MessageImportance.High, "Removed orphaned effect stub: " + csFile);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateEffectStubFiles" BeforeTargets="CoreCompile">
    <GenerateEffectStubs SkslFiles="@(AdditionalFiles)" EffectsDir="$(MSBuildProjectDirectory)\Effects" />
  </Target>

</Project>
