// @effect: default
// @animate
uniform float2 iResolution;
uniform float iTime;

const float REPEAT = 5.0;

float2x2 rot(float a) {
    float c = cos(a), s = sin(a);
    return float2x2(c, s, -s, c);
}

float sdBox(float3 p, float3 b) {
    float3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float box(float3 pos, float scale) {
    pos *= scale;
    float base = sdBox(pos, float3(0.4, 0.4, 0.1)) / 1.5;
    pos.xy *= 5.0;
    pos.y -= 3.5;
    pos.xy = pos.xy * rot(0.75);
    float result = -base;
    return result;
}

float box_set(float3 pos, float gTime) {
    float3 pos_origin = pos;
    pos = pos_origin;
    pos.y += sin(gTime * 0.4) * 2.5;
    pos.xy = pos.xy * rot(0.8);
    float box1 = box(pos, 2.0 - abs(sin(gTime * 0.4)) * 1.5);
    pos = pos_origin;
    pos.y -= sin(gTime * 0.4) * 2.5;
    pos.xy = pos.xy * rot(0.8);
    float box2 = box(pos, 2.0 - abs(sin(gTime * 0.4)) * 1.5);
    pos = pos_origin;
    pos.x += sin(gTime * 0.4) * 2.5;
    pos.xy = pos.xy * rot(0.8);
    float box3 = box(pos, 2.0 - abs(sin(gTime * 0.4)) * 1.5);
    pos = pos_origin;
    pos.x -= sin(gTime * 0.4) * 2.5;
    pos.xy = pos.xy * rot(0.8);
    float box4 = box(pos, 2.0 - abs(sin(gTime * 0.4)) * 1.5);
    pos = pos_origin;
    pos.xy = pos.xy * rot(0.8);
    float box5 = box(pos, 0.5) * 6.0;
    pos = pos_origin;
    float box6 = box(pos, 0.5) * 6.0;
    float result = max(max(max(max(max(box1, box2), box3), box4), box5), box6);
    return result;
}

float map(float3 pos, float gTime) {
    float box_set1 = box_set(pos, gTime);
    return box_set1;
}

half4 main(float2 fragCoord) {
    float2 p = (fragCoord.xy * 2.0 - iResolution.xy) / min(iResolution.x, iResolution.y);
    float3 ro = float3(0.0, -0.2, iTime * 4.0);
    float3 ray = normalize(float3(p, 1.5));
    ray.xy = ray.xy * rot(sin(iTime * 0.03) * 5.0);
    ray.yz = ray.yz * rot(sin(iTime * 0.05) * 0.2);
    float t = 0.1;
    float3 col = float3(0.0);
    float ac = 0.0;

    for (int i = 0; i < 99; i++) {
        float3 pos = ro + ray * t;
        pos = mod(pos - 2.0, 4.0) - 2.0;
        float gTime = iTime - float(i) * 0.01;

        float d = map(pos, gTime);

        d = max(abs(d), 0.01);
        ac += exp(-d * 23.0);

        t += d * 0.55;
    }

    col = float3(ac * 0.02);
    col += float3(0.0, 0.2 * abs(sin(iTime)), 0.5 + sin(iTime) * 0.2);

    return half4(half3(col), 1.0);
}
