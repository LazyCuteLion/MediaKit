// @effect: RippleEffect
// @surface
uniform shader iImage;
uniform float2 iResolution;
uniform float iTime;
// 每个矩阵的一列是一处波纹 (centerX, centerY, startTime)，共 3×3 = 9 圈并存。
// startTime = -10 表示空槽（早于任何真实波纹）。
// 不标 @property：这些是渲染侧的内部槽位，不映射成依赖属性。
uniform float3x3 iRipple0;
uniform float3x3 iRipple1;
uniform float3x3 iRipple2;
// @property: 0.1
uniform float amplitude;
// @property: 50.0
uniform float frequency;
// @property: 10.0
uniform float speed;
// @property: 3.0
uniform float duration;

float3 calcRipple(float2 uv, float2 center, float age, float aspectRatio) {
    if (age < 0.0 || age > duration) return float3(0.0);

    float timeFade = 1.0 - age / duration;

    float2 diff = uv - center;
    float dist = length(float2(diff.x, diff.y / aspectRatio));
    if (dist < 0.001) return float3(0.0);

    float2 dir = normalize(float2(diff.x, diff.y / aspectRatio));
    dir.y *= aspectRatio;

    float wavefront = age * speed * 0.03;
    if (dist > wavefront) return float3(0.0);

    float behind = wavefront - dist;
    float envelope = exp(-behind / 0.15) * timeFade / (1.0 + dist * 4.0);

    float wave = sin(frequency * dist - age * speed);
    float displacement = amplitude * wave * envelope;
    float light = amplitude * 0.15 * (1.0 - cos(frequency * dist - age * speed)) * envelope;

    return float3(dir * displacement, light);
}

float3 calcRippleWithReflection(float2 uv, float2 center, float age, float aspectRatio) {
    float3 result = calcRipple(uv, center, age, aspectRatio);
    result += calcRipple(uv, float2(-center.x, center.y), age, aspectRatio) * 0.3;
    result += calcRipple(uv, float2(2.0 - center.x, center.y), age, aspectRatio) * 0.3;
    result += calcRipple(uv, float2(center.x, -center.y), age, aspectRatio) * 0.3;
    result += calcRipple(uv, float2(center.x, 2.0 - center.y), age, aspectRatio) * 0.3;
    return result;
}

// 一个矩阵里 3 列的合成。常量下标展开，不依赖动态索引。
float3 sumSlots(float2 uv, float3x3 slots, float aspectRatio) {
    return calcRippleWithReflection(uv, slots[0].xy, iTime - slots[0].z, aspectRatio)
         + calcRippleWithReflection(uv, slots[1].xy, iTime - slots[1].z, aspectRatio)
         + calcRippleWithReflection(uv, slots[2].xy, iTime - slots[2].z, aspectRatio);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float aspectRatio = iResolution.x / iResolution.y;

    float3 acc = sumSlots(uv, iRipple0, aspectRatio)
               + sumSlots(uv, iRipple1, aspectRatio)
               + sumSlots(uv, iRipple2, aspectRatio);

    half4 color = iImage.eval((uv + acc.xy) * iResolution);
    color.rgb *= (1.0 - acc.z);
    return color;
}

