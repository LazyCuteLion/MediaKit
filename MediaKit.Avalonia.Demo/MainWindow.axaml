<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mk="https://github.com/LazyCuteLion/MediaKit"
        x:Class="MediaKit.Avalonia.Demo.MainWindow"
        Title="MediaKit.Avalonia Demo"
        Width="1280" Height="760">

    <Grid x:Name="container" Background="Green" ColumnDefinitions="*,Auto">
        <!-- 主内容区 -->
        <Grid RowDefinitions="*,Auto">
            <TextBlock Text="这是一个表面水印"
                       FontSize="50"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#7DFFFFFF"
                       IsHitTestVisible="False"
                       ZIndex="999"/>
            <Border x:Name="rect" Margin="10,10,10,10" >
                <Rectangle Fill="Green" Width="100" Height="100">
                    <Rectangle.Styles>
                        <Style Selector="Rectangle">
                            <Style.Animations>
                                <Animation Duration="0:0:2" IterationCount="Infinite" Easing="LinearEasing" >
                                    <KeyFrame Cue="50%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="2" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="2" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                    </KeyFrame>
                                </Animation>
                                <Animation Duration="0:0:2" IterationCount="Infinite" Easing="LinearEasing">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Fill" Value="#FFFF0000"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="16.6%">
                                        <Setter Property="Fill" Value="#FFFF7F00"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="33.3%">
                                        <Setter Property="Fill" Value="#FFFFFF00"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Fill" Value="#FF00FF00"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="66.6%">
                                        <Setter Property="Fill" Value="#FF0000FF"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="83.3%">
                                        <Setter Property="Fill" Value="#FF8B00FF"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Fill" Value="#FFFF0000"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Rectangle.Styles>
                </Rectangle>
            </Border>

            <!-- 底部栏：效果选择 + Open -->
            <Grid Grid.Row="1" Height="48" Background="#10000000" ColumnDefinitions="*,Auto">
                <ItemsControl x:Name="effectList" Margin="10,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}" GroupName="Effect"
                                         Padding="8,2"
                                         IsCheckedChanged="EffectRadioButton_Checked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto">
                    <Button Margin="10,0,0,0"
                            Padding="12,4"
                            VerticalAlignment="Center"
                            Click="BtnInvertProbe_Click"
                            Content="串色验证" />
                    <Button Grid.Column="1"
                            Margin="10,0"
                            Padding="12,4"
                            VerticalAlignment="Center"
                            Click="BtnOpen_Click"
                            Content="Open" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 右侧操作面板 -->
        <Border x:Name="rightPanel" Grid.Column="1" Background="#B0000000"
                Width="0" ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseInOut" />
                </Transitions>
            </Border.Transitions>
            <Grid Margin="12" Width="180">
                <!-- VR Panel -->
                <StackPanel x:Name="PanelVR"
                            IsVisible="False"
                            x:CompileBindings="False"
                            DataContext="{Binding #rect.Effect}">
                    <TextBlock Text="Zoom" Foreground="White" Margin="0,0,0,4" />
                    <Slider Minimum="0.1" Maximum="2" Value="{Binding Zoom}" />
                    <TextBlock Text="Fov" Foreground="White" Margin="0,8,0,4" />
                    <Slider Minimum="30" Maximum="180" Value="{Binding Fov}" />
                    <TextBlock Text="RotationX" Foreground="White" Margin="0,8,0,4" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding RotationX}" />
                    <TextBlock Text="RotationY" Foreground="White" Margin="0,8,0,4" />
                    <Slider Minimum="0.01" Maximum="0.99" Value="{Binding RotationY}" />
                </StackPanel>

                <!-- Ripple Panel -->
                <StackPanel x:Name="PanelRipple"
                            IsVisible="False"
                            x:CompileBindings="False"
                            DataContext="{Binding #rect.Effect}">
                    <TextBlock Text="Amplitude" Foreground="White" Margin="0,0,0,4" />
                    <Slider Minimum="0.01" Maximum="0.5" Value="{Binding Amplitude}" />
                    <TextBlock Text="Frequency" Foreground="White" Margin="0,8,0,4" />
                    <Slider Minimum="5" Maximum="150" Value="{Binding Frequency}" />
                    <TextBlock Text="Speed" Foreground="White" Margin="0,8,0,4" />
                    <Slider Minimum="1" Maximum="30" Value="{Binding Speed}" />
                    <TextBlock Text="Duration" Foreground="White" Margin="0,8,0,4" />
                    <Slider Minimum="0.5" Maximum="10" Value="{Binding Duration}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
