<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net462</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MediaKit.WPF</RootNamespace>
    <FxcPath>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry64))bin\10.0.26100.0\x64\fxc.exe</FxcPath>

    <!-- NuGet 元数据 -->
    <PackageId>MediaKit.WPF</PackageId>
    <Version>1.0.2</Version>
    <Authors>LazyCuteLion</Authors>
    <Description>WPF shader effects library providing Alpha channel separation, 360 panoramic video projection, and video tiling effects via pixel shaders.</Description>
    <PackageTags>WPF;ShaderEffect;Alpha;360Video;Panorama;Tile;PixelShader</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/LazyCuteLion/MediaKit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/LazyCuteLion/MediaKit</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- HLSL 编译: Shaders 下所有 .fx 自动纳入，无需逐个指定 -->
  <ItemGroup>
    <HlslShader Include="Shaders\*.fx" />
  </ItemGroup>

  <!-- 清理 Shaders\Compiled 下没有对应 .fx 的孤立 .ps 产物 -->
  <Target Name="CleanOrphanedPsFiles" BeforeTargets="CompileShaders">
    <ItemGroup>
      <_compiledPs Include="$(ProjectDir)Shaders\Compiled\*.ps" />
    </ItemGroup>
    <Delete Files="@(_compiledPs)" Condition="!Exists('$(ProjectDir)Shaders\%(Filename).fx')" />
  </Target>

  <!-- .fx → Compiled\{文件名}.ps (ps_3_0)：按文件名自动派生输出，增量编译 -->
  <Target Name="CompileShaders" BeforeTargets="RegisterCompiledShaders" Inputs="@(HlslShader)" Outputs="@(HlslShader->'$(ProjectDir)Shaders\Compiled\%(Filename).ps')" Condition="Exists('$(FxcPath)')">
    <MakeDir Directories="$(ProjectDir)Shaders\Compiled" />
    <Exec Command="&quot;$(FxcPath)&quot; /T ps_3_0 /E main /Fo &quot;$(ProjectDir)Shaders\Compiled\%(HlslShader.Filename).ps&quot; &quot;%(HlslShader.FullPath)&quot;" />
  </Target>

  <!-- 由 HlslShader 列表派生 Resource（每次构建都注册，规避通配陷阱与增量跳过导致的资源丢失） -->
  <Target Name="RegisterCompiledShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Resource Include="@(HlslShader->'Shaders\Compiled\%(Filename).ps')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 源生成器：.fx 作为 AdditionalFiles 喂给生成器，按标记产出效果类样板 -->
  <ItemGroup>
    <AdditionalFiles Include="Shaders\*.fx" />
    <ProjectReference Include="..\MediaKit.ShaderEffectGenerators\MediaKit.ShaderEffectGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 编译前为每个 @effect 生成/清理手写侧骨架 .cs -->
  <Import Project="GenerateEffectStubs.targets" />

</Project>
